{
  "rules": {
    ".read": false,
    ".write": false,
    
    "navigation": {
      ".read": true,
      ".write": true,
      "mode": {
        ".read": true,
        ".write": true,
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    
    "detection": {
      ".read": true,
      ".write": true,
      "object": {
        ".read": true,
        ".write": true,
        "side": {
          ".validate": "newData.isString() && (newData.val() == 'left' || newData.val() == 'right')"
        },
        "distance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "object": {
          ".validate": "newData.isString()"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    
    "esp32cam": {
      ".read": true,
      ".write": true,
      "online": {
        ".validate": "newData.isBoolean()"
      },
      "ip": {
        ".validate": "newData.isString()"
      }
    },
    
    "esp32c3": {
      ".read": true,
      ".write": true,
      "online": {
        ".validate": "newData.isBoolean()"
      },
      "ip": {
        ".validate": "newData.isString()"
      }
    }
  }
}

